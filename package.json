{
  "name": "yuma3d-storefront",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node tests/e2e/checkout.e2e.mjs",
    "stripe:check": "node scripts/stripe-smoke-test.mjs",
    "logs": "wrangler tail",
    "build:pages": "python3 tools/build-product-pages.py && python3 tools/prepare-stripe-images.py",
    "build": "python3 tools/build-product-pages.py && python3 tools/prepare-stripe-images.py && python3 tools/build-checkout-worker.py && node scripts/validate-artifact.mjs"
  },
  "devDependencies": {
    "stripe": "^23.1.0",
    "wrangler": "^4.156.0"
  },
  "engines": {
    "node": ">=20"
  }
}
