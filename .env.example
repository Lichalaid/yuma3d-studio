# Local trial with `npm run dev` (copy this file to .env.local; it is ignored by git).
# On Vercel these same names go in Settings → Environment Variables (see PANEL-ADMIN.md and ACTIVAR-STRIPE.md).

# ---- Admin panel (/admin/) ----
# Locally you can leave both empty: `npm run dev` prints a temporary password.
# For Vercel create them with `npm run admin:password`.
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
# Only on Vercel (locally the panel saves into this folder):
# GITHUB_REPO=owner/repo
# GITHUB_TOKEN=github_pat_...
# GITHUB_BRANCH=main

# ---- Stripe (use ONLY Yuma's sandbox here: keys that start with rk_test_) ----
CHECKOUT_ENABLED=true
STRIPE_MODE=test
STRIPE_ACCOUNT_ID=acct_1UVZa22S141stGeG
STRIPE_SECRET_KEY=rk_test_REPLACE_ME
# Printed by `stripe listen --forward-to localhost:3000/api/stripe/webhook`
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
# "log" prints the order emails in the terminal instead of sending them (test mode only).
ORDER_EMAIL_MODE=log
ORDER_EMAIL_API_KEY=
ORDER_EMAIL_FROM=
